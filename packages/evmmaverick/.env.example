# WalletConnect / Reown project id — https://cloud.reown.com
# REQUIRED. The build fails without it, on purpose: a missing id gives you a
# connect modal that half-works at runtime instead of an error you can see.
# Register your own. Never reuse someone else's — relay metadata routes
# through whoever owns the id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Alchemy key, used for both Ethereum mainnet and Base (enable both networks
# on the key). Optional but strongly recommended: the page reads your NFT
# balance on every wallet connect, and viem's public RPC rate-limits hard
# enough that holders start seeing "couldn't check your wallet" instead of a
# claim button. Base is only hit when the listing is an L2 one.
NEXT_PUBLIC_ALCHEMY_KEY=

# Set to "true" to expose the ?preview= design-review states on a deployed
# build. Leave unset in production — it lets anyone view fixture screens.
NEXT_PUBLIC_ENABLE_PREVIEW=

# Public origin of the deployed site, e.g. https://names.evmaverick.xyz
# Used to build absolute OG / Twitter card URLs. Falls back to localhost.
NEXT_PUBLIC_SITE_URL=
