# Alchemy API key used for Base + Ethereum mainnet RPC (ENS resolution).
# Without it the app falls back to viem's rate-limited public RPC.
NEXT_PUBLIC_ALCHEMY_KEY=

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Optional — a shared default is used when unset.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
