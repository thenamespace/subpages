# Alchemy API key used for Base + Ethereum mainnet RPC (ENS resolution).
# Without it the app falls back to viem's rate-limited public RPC.
NEXT_PUBLIC_ALCHEMY_KEY=

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# REQUIRED. Register your own project — the app fails to start if unset.
# Never use someone else's id in production; relay metadata routes
# through the account that owns the id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# === Sponsored burn-and-reissue flow (server-only) ===

# Private key of the sponsor wallet. This address MUST:
#  1) own the child-registry NFT for PARENT_NAME (required to call burn)
#  2) be on the listing's mint whitelist (required to call mint)
# For the enscomponent.eth test this is 0x507E27d7191c556e0Fd40799cdF4AbcC9c7F0706.
# Never commit. Never ship to the client (no NEXT_PUBLIC_ prefix).
WALLET_KEY=

# Base mainnet RPC. If unset the API route falls back to Alchemy using
# NEXT_PUBLIC_ALCHEMY_KEY (or viem's public RPC as last resort).
BASE_RPC_URL=

# The parent ENS name users burn under and re-issue under. Single source of
# truth so we can flip enscomponent.eth (testing) -> pizzaday.eth (prod)
# without code changes. Must match the listing in list-manager.
PARENT_NAME=enscomponent.eth

# Child-registry contract on Base for PARENT_NAME (the contract that
# implements burn()). For enscomponent.eth this is
# 0xBE4959D119CbDBFa9825C89Be482e486788B3C95. Sourced from
# list-manager's l2Metadata.registryAddress.
PARENT_REGISTRY_ADDRESS=

# Client-side mirror of PARENT_NAME (the parent used by the sponsored
# burn-and-reissue flow). Must match PARENT_NAME on the server side.
# enscomponent.eth for staging, pizzaday.eth for production.
NEXT_PUBLIC_PARENT_NAME=enscomponent.eth
